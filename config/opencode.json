{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/deepseek-v4.1-flash-free",
  "providers": {
    "openrouter": {
      "settings": {
        "apiKey": "{env:OPENROUTER_API_KEY}"
      }
    }
  },
  "lsp": {
    "java": {
      "command": ["java", "-jar", "/opt/jdtls/plugins/org.eclipse.equinox.launcher_*.jar"],
      "args": ["-configuration", "/opt/jdtls/config_linux"],
      "extensions": [".java"]
    }
  }
}
