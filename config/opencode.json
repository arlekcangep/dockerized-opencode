{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/deepseek-v4.1-flash-free",
  "_fallback_model": "opencode/nemotron-3.5-super-vl-free",
  "providers": {
    "openrouter": {
      "settings": {
        "apiKey": "{env:OPENROUTER_API_KEY}"
      }
    },
    "teamo": {
      "package": "@ai-sdk/openai-compatible",
      "name": "TeamoRouter",
      "settings": { 
        "baseURL": "https://api.teamorouter.com/v1", 
        "apiKey": "sk-teamo-56dd18d288b4a96c8ff8d9f226beaaf54d37975db995fbdf" 
      },
      "models": { 
        "deepseek-flash-free": { 
          "name": "deepseek-flash-free"  
        },
        "glm-5.3-flash-free": { 
          "name": "glm-5.3-flash-free" } 
        }
        
    },
    "dahl": {
      "name": "Dahl",
      "package": "@opencode/ai/providers/openai-compatible", 
      "settings": {
        "baseURL": "https://inference.dahl.global/v1",
        "apiKey": "dahl_BoSyG5Xyr3bKmbqxCVvGza32tQ36pbmKY"
      },
      "models": {
        "MiniMaxAI/MiniMax-M2.7": {
          "model": "MiniMaxAI/MiniMax-M2.7"
        },
        "deepseek-ai/DeepSeek-V4-Flash-0731": {
          "model": "deepseek-ai/DeepSeek-V4-Flash-0731"
        },
        "zai-org/GLM-5.3-Flash": {
          "model": "zai-org/GLM-5.3-Flash"
        }
      }
    }
  },
  "lsp": {
    "java": {
      "command": ["java", "-jar", "/opt/jdtls/launcher.jar", "-configuration", "/opt/jdtls/config_linux"],
      "extensions": [".java"]
    },
    "csharp": {
      "command": ["csharp-ls"],
      "extensions": [".cs"]
    },
    "typescript": {
      "command": ["typescript-language-server", "--stdio"],
      "extensions": [".ts", ".tsx", ".mts", ".cts", ".js", ".jsx", ".mjs", ".cjs"]
    },
    "bash": {
      "command": ["bash-language-server", "start"],
      "extensions": [".sh", ".bash"]
    },
    "yaml": {
      "command": ["yaml-language-server", "--stdio"],
      "extensions": [".yml", ".yaml"]
    },
    "python": {
      "command": ["pyright-langserver", "--stdio"],
      "extensions": [".py", ".pyi"]
    }
  }
}
